# Template - copy to secret.yaml and fill in base64 encoded values
# Generate base64: echo -n 'your-value' | base64
# DO NOT commit secret.yaml to git
apiVersion: v1
kind: Secret
metadata:
  name: kyomi-secrets
  namespace: kyomi
type: Opaque
data:
  # PostgreSQL password
  POSTGRES_PASSWORD: REPLACE_WITH_BASE64_ENCODED_PASSWORD
  # Database URL for backend
  DATABASE_URL: REPLACE_WITH_BASE64_ENCODED_DATABASE_URL
  # Example: echo -n 'postgresql://kyomi:password@postgres:5432/kyomi?sslmode=verify-ca&sslrootcert=/etc/ssl/certs/ca-certificates.crt' | base64

  # Trial ClickHouse password
  SAMPLE_CLICKHOUSE_PASSWORD: REPLACE_WITH_BASE64_ENCODED_PASSWORD

  # Kyomi Connect - ES256 PKCS#8 private key for signing customer deployment tokens
  # Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt | base64
  CONNECT_JWT_PRIVATE_KEY: REPLACE_WITH_BASE64_ENCODED_PRIVATE_KEY
