{
  "$schema": "https://raw.githubusercontent.com/nicoverbruggen/tauri-settings-schema/main/schema.json",
  "productName": "Kyomi",
  "version": "0.1.0",
  "identifier": "ai.kyomi.desktop",
  "build": {},
  "app": {
    "windows": [
      {
        "title": "Kyomi",
        "width": 1280,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
