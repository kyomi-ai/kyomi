# Coming Soon Mode
# Set to 'true' to show "Coming Soon" banner instead of login
# Use for public launch before enabling sign-in
# Default: false (login enabled)
VITE_COMING_SOON=false

# DuckDB Cache Feature Flag
# Set to 'true' to enable DuckDB-based local caching instead of HTTP cache
# Default: false (uses HTTP cache)
VITE_USE_DUCKDB_CACHE=true

# Direct BigQuery Access Feature Flag
# Set to 'true' to enable direct BigQuery API access from browser (no backend proxy)
# Requires VITE_USE_DUCKDB_CACHE=true for optimal performance
# Benefits: Reduces costs, improves privacy, eliminates proxy latency
# Default: false (uses backend proxy)
VITE_USE_DIRECT_BIGQUERY=true
