{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Kyomi Backend API",
            "type": "debugpy",
            "request": "launch",
            "module": "kyomi_api.main",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src",
            "python": "/usr/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "DATABASE_URL": "postgresql://kyomi:kyomi@localhost/kyomi",
                "GOOGLE_CLOUD_PROJECT": "kyomi-demo",
                "PORT": "8001"
            },
            "envFile": "${workspaceFolder}/.env",
            "args": [],
            "justMyCode": false,
            "stopOnEntry": false,
            "subProcess": true
        },
        {
            "name": "Debug BigQuery Tools",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_bigquery_tools.py",
                "-v",
                "-s"
            ],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "DATABASE_URL": "postgresql://kyomi:kyomi@localhost/kyomi",
                "GOOGLE_CLOUD_PROJECT": "kyomi-demo"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        },
        {
            "name": "Debug Chat Agent",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_chat_agent.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "DATABASE_URL": "postgresql://kyomi:kyomi@localhost/kyomi",
                "GOOGLE_CLOUD_PROJECT": "kyomi-demo"
            },
            "envFile": "${workspaceFolder}/.env",
            "justMyCode": false
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}