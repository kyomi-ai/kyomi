# Kyomi Environment Configuration Template
# Copy to .env and fill in your values
# Backend: Rust (apps/backend-rust/)

# =============================================================================
# REQUIRED
# =============================================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://kyomi:password@localhost:5433/kyomi

# Redis URL (dev uses port 6380, prod uses 6379)
REDIS_URL=redis://localhost:6380/0

# JWT secret — generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# Encryption key for stored credentials (Fernet) — generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_encryption_key_here

# Master key for encrypting workspace-level secrets (BYOK API keys).
# Generate with: openssl rand -base64 32
# REQUIRED in SaaS mode. Without it, the server will refuse to start.
WORKSPACE_SECRETS_KEY=

# Anthropic API key (for AI features)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AI budget per user per month in USD (SaaS mode only, default: 5.0)
# AI_BUDGET_PER_USER=5.0

# Frontend URL (used for CORS, redirects, WebAuthn RP ID)
FRONTEND_URL=http://localhost:5173

# Base URL (API base, used for OAuth callbacks)
BASE_URL=http://localhost:8002

# =============================================================================
# OPTIONAL — Features disabled if not set
# =============================================================================

# Server port (default: 8002)
# PORT=8002

# Enable background schedulers (default: true)
# ENABLE_SCHEDULERS=true

# WebAuthn configuration (defaults derived from FRONTEND_URL)
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=Kyomi

# Google OAuth (for BigQuery datasource connections)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Stripe (billing)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Slack integration
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=
# SLACK_FEEDBACK_WEBHOOK_URL=
# SLACK_FEEDBACK_CHANNEL_ID=

# SMTP (email verification, alerts)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=noreply@kyomi.ai
# SMTP_FROM_NAME=Kyomi
# SUPPORT_EMAIL=support@kyomi.ai

# Web Push notifications (VAPID)
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:support@kyomi.ai

# Kyomi Analytics (internal event collection)
# ANALYTICS_SIGNING_SECRET=
# ANALYTICS_CLICKHOUSE_HOST=localhost
# ANALYTICS_CLICKHOUSE_PORT=8126
# ANALYTICS_CLICKHOUSE_PASSWORD=
# ANALYTICS_CLICKHOUSE_SECURE=false

# Kyomi Connect (on-prem database agent)
# CONNECT_JWT_PRIVATE_KEY=
# CONNECT_URL=wss://your-domain.com/connect/v1

# Sample ClickHouse (try-before-signup feature)
# SAMPLE_CLICKHOUSE_HOST=localhost
# SAMPLE_CLICKHOUSE_PORT=8126
# SAMPLE_CLICKHOUSE_DATABASE=acme_analytics
# SAMPLE_CLICKHOUSE_PASSWORD=
# SAMPLE_CLICKHOUSE_USER=sample_readonly
# SAMPLE_CLICKHOUSE_SECURE=false
