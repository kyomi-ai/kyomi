#######################################
# Kyomi Production Environment Config
#######################################
#
# SETUP INSTRUCTIONS:
#
# 1. Copy this file to .env.production:
#    cp .env.production.example .env.production
#
# 2. Generate random secrets:
#    JWT_SECRET_KEY:      openssl rand -hex 32
#    ENCRYPTION_KEY:      openssl rand -hex 32
#    POSTGRES_PASSWORD:   openssl rand -base64 32
#
# 3. Get API keys:
#    - Anthropic: https://console.anthropic.com/
#    - Google OAuth: https://console.cloud.google.com/
#    - Stripe: https://dashboard.stripe.com/
#
# 4. Configure Google OAuth:
#    - Authorized redirect URI: https://app.kyomi.ai/auth/callback
#    - Authorized JavaScript origins: https://app.kyomi.ai
#
# 5. Configure Stripe webhook:
#    - Endpoint URL: https://app.kyomi.ai/api/v1/billing/webhook
#    - Events: customer.subscription.*, invoice.*, payment_intent.*
#
# ⚠️  NEVER commit .env.production to git!
#

# === Database Configuration ===
POSTGRES_DB=kyomi
POSTGRES_USER=kyomi
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
DATABASE_URL=postgresql://kyomi:CHANGE_ME_RANDOM_PASSWORD@postgres:5432/kyomi

# === Backend API Configuration ===
# Anthropic API key for AI features
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# JWT secret for access tokens (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_256_BIT_RANDOM

# Encryption key for sensitive data (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=CHANGE_ME_256_BIT_RANDOM

# Frontend URL (used for CORS and redirects)
FRONTEND_URL=https://app.kyomi.ai

# === Authentication Configuration ===
# Authentication method (oauth for production)
AUTH_METHOD=oauth

# Google OAuth credentials
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# === Billing Configuration (Stripe) ===
# Use production keys from https://dashboard.stripe.com/
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# === Plausible Analytics Configuration ===
# Secret key for Plausible (generate with: openssl rand -base64 64)
PLAUSIBLE_SECRET_KEY_BASE=CHANGE_ME_RANDOM_BASE64

# Plausible database password (can be same as POSTGRES_PASSWORD or separate)
PLAUSIBLE_DB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD

# === Google Cloud Configuration ===
# Optional: If using a specific Google Cloud project
# GOOGLE_CLOUD_PROJECT=your-project-id

# === Logging Configuration ===
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Node environment (production/development)
NODE_ENV=production

# === Port Configuration (internal to Docker network) ===
# Backend API port (exposed to host for nginx proxy)
BACKEND_PORT=8001

# Frontend port (exposed to host for nginx proxy)
FRONTEND_PORT=3000

# PostgreSQL port (internal only, not exposed to host)
POSTGRES_PORT=5432

# === Optional: Error Tracking ===
# Uncomment and configure if using Sentry
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# === Optional: Email Configuration ===
# Uncomment if you want email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@kyomi.ai
