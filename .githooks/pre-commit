#!/bin/bash
# Pre-commit hook: blocks lint suppressions, server_fn/REST divergence,
# Leptos signal disposal-safety violations, and real-world identifiers.
# Clippy runs in CI on PRs (not locally).

set -e

# Checks 1/2/2b normally inspect the staged delta. Git gives pre-commit no
# --amend argument, so an empty index delta conservatively rechecks HEAD's
# changes against its first parent (or the empty tree for a root commit).
# This catches violations in a hookless commit during an empty-index amend.
lint_diff_args=(--cached)
if git diff --cached --quiet; then
    if git rev-parse --verify HEAD >/dev/null 2>&1; then
        head_parents=$(git rev-list --parents -n 1 HEAD)
        read -r head_commit lint_base other_parents <<< "$head_parents"
        if [ -z "$lint_base" ]; then
            lint_base=$(git hash-object -w -t tree --stdin </dev/null)
        fi
        lint_diff_args+=("$lint_base")
    fi
else
    diff_status=$?
    if [ "$diff_status" -ne 1 ]; then
        echo "❌ Cannot determine staged changes — commit blocked." >&2
        exit "$diff_status"
    fi
fi
# Capture before filtering so Git errors cannot become a false clean result.
lint_changed_files=$(git diff "${lint_diff_args[@]}" --name-only --diff-filter=ACM)

# --- Check 1: Reject new lint suppressions in the selected delta ---
echo "🔍 Checking for new lint suppressions..."

# Check .rs files for #[allow(...)]
rs_patch=$(git diff "${lint_diff_args[@]}" -- '*.rs')
rs_violations=$(printf '%s\n' "$rs_patch" | grep '^+' | grep -v '^+++' | grep '#\[allow(' || true)

# Check Cargo.toml for = "allow" lint downgrades
toml_patch=$(git diff "${lint_diff_args[@]}" -- '*/Cargo.toml' 'Cargo.toml')
toml_violations=$(printf '%s\n' "$toml_patch" | grep '^+' | grep -v '^+++' | grep '= "allow"' || true)

violations="${rs_violations}${toml_violations}"

if [ -n "$violations" ]; then
    echo ""
    echo "❌ New lint suppressions detected — commit blocked."
    echo ""
    [ -n "$rs_violations" ] && echo "In .rs files:" && echo "$rs_violations" && echo ""
    [ -n "$toml_violations" ] && echo "In Cargo.toml:" && echo "$toml_violations" && echo ""
    echo "Fix the lint warning instead of suppressing it."
    exit 1
fi

echo "✅ No new lint suppressions."

# Collect unstaged and untracked lint trigger paths independently of the index.
# Lint them too so staging a sibling cannot hide unsafe work left in the tree.
# Fail closed if Git cannot enumerate either set.
unstaged_or_untracked_matching() {
    local pattern="$1"
    local diff_file untracked_file
    diff_file="$(mktemp)"
    untracked_file="$(mktemp)"

    if ! git diff --name-only > "$diff_file"; then
        rm -f "$diff_file" "$untracked_file"
        echo "" >&2
        echo "❌ 'git diff --name-only' failed — cannot verify whether any" >&2
        echo "   unstaged files match pattern: $pattern" >&2
        echo "   Refusing to report a false 'nothing unstaged' result." >&2
        exit 1
    fi

    if ! git ls-files --others --exclude-standard > "$untracked_file"; then
        rm -f "$diff_file" "$untracked_file"
        echo "" >&2
        echo "❌ 'git ls-files --others --exclude-standard' failed — cannot verify" >&2
        echo "   whether any untracked files match pattern: $pattern" >&2
        echo "   Refusing to report a false 'nothing untracked' result." >&2
        exit 1
    fi

    cat "$diff_file" "$untracked_file" | grep "$pattern" | sort -u
    rm -f "$diff_file" "$untracked_file"
    return 0
}

# --- Check 2: server_fn / REST divergence lint (KYO-122) ---
# Runs before clippy because it is orders of magnitude faster (< 200ms)
# and catches the class of bugs that triggered KYO-115. Lints the selected
# delta (staged, or HEAD against its parent when empty) whenever it touches
# `crates/kyomi-ui/src/server_fns/*.rs`,
# AND, independently and unconditionally (KYO-712 — see this file's header
# for why "independently" matters), scans for unstaged/untracked files
# matching the same pattern so a narrowed index can never hide behind a
# staged sibling.
echo "🔍 Checking server_fn / REST divergence..."

staged_server_fns=$(printf '%s\n' "$lint_changed_files" \
    | grep '^crates/kyomi-ui/src/server_fns/.*\.rs$' || true)

if [ -n "$staged_server_fns" ]; then
    # shellcheck disable=SC2086  # word-splitting is intentional here
    if ! ./scripts/lint/check-server-fns.sh $staged_server_fns; then
        echo ""
        echo "❌ server_fn lint failed — commit blocked."
        echo "   Fix the reported violations or add a justified escape-hatch"
        echo "   comment (see scripts/lint/check-server-fns.sh header)."
        exit 1
    fi
    echo "✅ server_fn lint clean."
fi

unstaged_server_fns="$(unstaged_or_untracked_matching '^crates/kyomi-ui/src/server_fns/.*\.rs$')"
if [ -n "$unstaged_server_fns" ]; then
    echo "🔍 Checking server_fn lint for unstaged/untracked files..."
    # shellcheck disable=SC2086  # lint scripts accept a list of paths
    if ! ./scripts/lint/check-server-fns.sh $unstaged_server_fns; then
        echo "❌ server_fn lint failed for unstaged/untracked files — commit blocked."
        exit 1
    fi
elif [ -z "$staged_server_fns" ]; then
    echo "✅ server_fn lint skipped (no matching files)."
fi

# --- Check 2b: Leptos signal disposal-safety lint ---
# Runs before clippy for the same reason as Check 2 (pure bash+awk, ~200ms).
# Lints the selected delta whenever it touches
# `crates/kyomi-ui/src/**/*.rs` — Rule A (bare .set()/.update() in
# spawn_local/deferred contexts) always blocks; Rule B (bare .get() in
# Signal::derive/Memo::new) blocks only on findings NOT already recorded in
# scripts/lint/disposal-safety-baseline.txt, or that exceed their recorded
# occurrence count there (KYO-679's ratchet — see that script's own header
# NOTE for the full design and why file-scoped runs like this one never fail
# on a *shrinking* baseline) — AND, independently and unconditionally
# (KYO-712, same reasoning as Check 2 above), scans for unstaged/untracked
# files matching the same pattern.
echo "🔍 Checking Leptos signal disposal safety..."

staged_disposal_files=$(printf '%s\n' "$lint_changed_files" \
    | grep '^crates/kyomi-ui/src/.*\.rs$' || true)

if [ -n "$staged_disposal_files" ]; then
    # shellcheck disable=SC2086  # word-splitting is intentional here
    if ! ./scripts/lint/check-disposal-safety.sh $staged_disposal_files; then
        echo ""
        echo "❌ disposal-safety lint failed — commit blocked."
        echo "   Fix the reported violations (use .try_set()/.try_update()/.try_get()) or"
        echo "   add a justified escape-hatch comment: // lint-allow: disposal-safe=<why>"
        echo "   (justification needs >= 5 characters). See scripts/lint/check-disposal-safety.sh"
        echo "   header for details."
        echo "   A Rule B 'ERROR:B ... not covered by ... baseline' means a NEW,"
        echo "   blocking site — fix it the same way, or if it's a deliberate, reviewed"
        echo "   addition, regenerate the baseline: ./scripts/lint/check-disposal-safety.sh --update-baseline"
        exit 1
    fi
    echo "✅ disposal-safety lint clean."
fi

unstaged_disposal_files="$(unstaged_or_untracked_matching '^crates/kyomi-ui/src/.*\.rs$')"
if [ -n "$unstaged_disposal_files" ]; then
    echo "🔍 Checking disposal-safety lint for unstaged/untracked files..."
    # shellcheck disable=SC2086  # lint scripts accept a list of paths
    if ! ./scripts/lint/check-disposal-safety.sh $unstaged_disposal_files; then
        echo "❌ disposal-safety lint failed for unstaged/untracked files — commit blocked."
        exit 1
    fi
elif [ -z "$staged_disposal_files" ]; then
    echo "✅ disposal-safety lint skipped (no matching files)."
fi

# --- Check 2c: Real-world identifier lint (KYO-662) ---
# Blocks customer/production identifiers (GCP service-account addresses,
# non-allowlisted email domains, public IPv4 addresses, credential-shaped
# tokens, and salted-hash-matched denylisted identifiers) from ever being
# staged, in any tracked file. This is the fast local signal; CI's full-tree
# and commit-message scans are the gate that actually matters, since
# core.hooksPath is per-clone and cannot be committed. See
# scripts/lint/check-real-identifiers.sh's own header for the full rule set.
echo "🔍 Checking for real-world identifiers..."

staged_files=$(git diff --cached --name-only --diff-filter=ACM || true)

if [ -n "$staged_files" ]; then
    # shellcheck disable=SC2086  # word-splitting is intentional here
    if ! ./scripts/lint/check-real-identifiers.sh $staged_files; then
        echo ""
        echo "❌ Real-identifier lint failed — commit blocked."
        echo "   Remove the flagged identifier, or (only for a deliberately"
        echo "   fake test fixture) add a path exception to"
        echo "   scripts/lint/real-identifiers-allow.txt."
        exit 1
    fi
    echo "✅ Real-identifier lint clean."
else
    echo "✅ Real-identifier lint skipped (no files staged)."
fi
