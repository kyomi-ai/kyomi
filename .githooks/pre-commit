#!/bin/bash
# Pre-commit hook: blocks lint suppressions, clippy warnings, and unreviewed commits.
# Order: fast checks first (lints, clippy), expensive check last (review signature).
# This avoids wasting an LLM review cycle on code that fails basic linting.

set -e

# --- Check 1: Reject new lint suppressions in staged files ---
echo "🔍 Checking for new lint suppressions..."

# Check .rs files for #[allow(...)]
rs_violations=$(git diff --cached -- '*.rs' | grep '^+' | grep -v '^+++' | grep '#\[allow(' || true)

# Check Cargo.toml for = "allow" lint downgrades
toml_violations=$(git diff --cached -- '*/Cargo.toml' 'Cargo.toml' | grep '^+' | grep -v '^+++' | grep '= "allow"' || true)

violations="${rs_violations}${toml_violations}"

if [ -n "$violations" ]; then
    echo ""
    echo "❌ New lint suppressions detected — commit blocked."
    echo ""
    [ -n "$rs_violations" ] && echo "In .rs files:" && echo "$rs_violations" && echo ""
    [ -n "$toml_violations" ] && echo "In Cargo.toml:" && echo "$toml_violations" && echo ""
    echo "Fix the lint warning instead of suppressing it."
    exit 1
fi

echo "✅ No new lint suppressions."

# --- Check 2: Cargo clippy (staged crates only) ---
# Only check crates that have staged .rs files, not the full workspace.
# This prevents warnings in other crates (e.g. from parallel agents working
# on the same branch) from blocking unrelated commits.
echo "🔍 Running cargo clippy..."

staged_rs_files=$(git diff --cached --name-only -- '*.rs' || true)

if [ -z "$staged_rs_files" ]; then
    echo "✅ Clippy skipped (no Rust files staged)."
else
    # Derive -p flags from staged file paths.
    staged_crates=$(echo "$staged_rs_files" \
        | sed -n 's|^\(crates/[^/]*\)/.*|\1|p' \
        | sort -u \
        | while read -r crate_dir; do
            if [ -f "$crate_dir/Cargo.toml" ]; then
                pkg=$(grep '^name' "$crate_dir/Cargo.toml" | head -1 | sed 's/.*= *"\(.*\)"/\1/')
                [ -n "$pkg" ] && echo "-p $pkg"
            fi
        done)

    # Files outside crates/ (e.g. apps/server) → fall back to workspace.
    if echo "$staged_rs_files" | grep -qv '^crates/'; then
        staged_crates="--workspace"
    fi

    if [ -z "$staged_crates" ]; then
        echo "✅ Clippy skipped (no crate detected)."
    else
        warnings=$(cargo clippy $staged_crates 2>&1 \
            | grep "^warning:" \
            | grep -v "cargo:warning\|generated\|Model file\|Downloaded\|Downloading\|too many arguments" \
            || true)

        if [ -n "$warnings" ]; then
            echo ""
            echo "❌ Clippy warnings found — commit blocked."
            echo ""
            echo "$warnings"
            echo ""
            echo "Fix warnings and try again."
            exit 1
        fi

        echo "✅ Clippy clean."
    fi
fi

# --- Check 3: Verify code review signature ---
echo "🔍 Verifying code review approval..."

REVIEW_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MCowBQYDK2VwAyEApRtsZODQxaUNP383HB/iqLHSlrf92Fe3UB43Bc2TaG0=
-----END PUBLIC KEY-----"

DIFF_HASH=$(git diff --cached | sha256sum | awk '{print $1}')

if [ ! -f .review-approval ]; then
    echo ""
    echo "❌ No code review approval found — commit blocked."
    echo "   Run the code-review-architect agent to review and sign off on changes."
    exit 1
fi

APPROVED_HASH=$(sed -n '1p' .review-approval)
SIGNATURE=$(sed -n '2p' .review-approval)

if [ "$DIFF_HASH" != "$APPROVED_HASH" ]; then
    echo ""
    echo "❌ Code review approval is stale — staged diff has changed since review."
    echo "   Expected: $APPROVED_HASH"
    echo "   Got:      $DIFF_HASH"
    echo "   Re-run the code-review-architect agent to review current changes."
    exit 1
fi

PUB_FILE=$(mktemp)
SIG_FILE=$(mktemp)
HASH_FILE=$(mktemp)
trap 'rm -f "$PUB_FILE" "$SIG_FILE" "$HASH_FILE"' EXIT

echo "$REVIEW_PUBLIC_KEY" > "$PUB_FILE"
echo -n "$DIFF_HASH" > "$HASH_FILE"
echo "$SIGNATURE" | base64 -d > "$SIG_FILE"

if ! openssl pkeyutl -verify -pubin -inkey "$PUB_FILE" -in "$HASH_FILE" -sigfile "$SIG_FILE" >/dev/null 2>&1; then
    echo ""
    echo "❌ Code review signature is INVALID — commit blocked."
    echo "   The approval file may have been tampered with."
    echo "   Only the code-review-architect agent can produce valid signatures."
    exit 1
fi

echo "✅ Code review signature verified."
