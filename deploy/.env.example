# =============================================================================
# Kyomi Community Edition — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments. Uncomment to enable optional features.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Database
# -----------------------------------------------------------------------------
# Password for the PostgreSQL database. Used by both the postgres container
# and the kyomi application's DATABASE_URL.
# IMPORTANT: Set a strong password. Generate with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Required — Security Keys
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# Encryption key for encrypting sensitive data at rest (datasource credentials).
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Required — LLM Provider (powers AI features)
# -----------------------------------------------------------------------------
# Supported providers: anthropic, openai, gemini
LLM_PROVIDER=anthropic

# Your API key for the LLM provider
LLM_API_KEY=

# Optional: Override the default model for your provider
# LLM_MODEL=

# Optional: Custom API base URL (for OpenAI-compatible providers like Ollama)
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# The external URL where users will access Kyomi.
# Change this if using a domain name or reverse proxy.
KYOMI_URL=http://localhost:8080

# The host port to expose Kyomi on (default: 8080)
# KYOMI_PORT=8080

# WebAuthn Relying Party ID — must match the hostname users access.
# For local installs this should be "localhost".
# For a domain like "kyomi.example.com", set it to "kyomi.example.com".
WEBAUTHN_RP_ID=localhost

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# PASSWORD_AUTH_ENABLED=true
# PASSKEYS_ENABLED=true

# -----------------------------------------------------------------------------
# Optional — Email (SMTP)
# -----------------------------------------------------------------------------
# Uncomment to enable email notifications (watch alerts, invitations, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=kyomi@example.com
# SMTP_FROM_NAME=Kyomi

# -----------------------------------------------------------------------------
# Optional — Web Push Notifications
# -----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com
#
# Push subscription endpoints are only accepted from a built-in allowlist of
# browser push services (FCM, Mozilla autopush, WNS, APNs). If you run your
# own push relay instead of a browser's default push service, name its
# host(s) here (comma-separated) to allow it too. Leave unset otherwise.
# IMPORTANT: if you use a custom relay, set this BEFORE upgrading. On
# upgrade, a one-time SQL migration purges existing push_subscriptions rows
# that don't match an allowed host, and that migration cannot see this env
# var — it will delete your custom-relay rows if this isn't set yet. A
# startup sweep runs right after on every boot and DOES see this env var, so
# once it's set, your custom-relay subscriptions are correctly kept going
# forward — it just can't restore rows the migration already deleted.
# PUSH_ALLOWED_ENDPOINT_HOSTS=

# -----------------------------------------------------------------------------
# Optional — Google OAuth (for Google sign-in and BigQuery datasources)
# -----------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
