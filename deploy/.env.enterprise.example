# =============================================================================
# Kyomi Enterprise Edition — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
# Lines starting with # are comments. Uncomment to enable optional features.
# =============================================================================

# -----------------------------------------------------------------------------
# Required — Database
# -----------------------------------------------------------------------------
# Password for the PostgreSQL database. Used by both the postgres container
# and the kyomi application's DATABASE_URL.
# IMPORTANT: Set a strong password. Generate with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Required — Security Keys
# -----------------------------------------------------------------------------
# Secret key for signing JWT tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=

# Encryption key for encrypting sensitive data at rest (datasource credentials).
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Required — LLM Provider (powers AI features)
# -----------------------------------------------------------------------------
# Supported providers: anthropic, openai, gemini
LLM_PROVIDER=anthropic

# Your API key for the LLM provider
LLM_API_KEY=

# Optional: Override the default model for your provider
# LLM_MODEL=

# Optional: Custom API base URL (for OpenAI-compatible providers like Ollama)
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# Optional: Reasoning effort, passed to the provider unchanged. Unset sends
# nothing (the provider/model default applies). Values differ per provider
# (low, medium, high, max, none, a number, ...). `omit` sends no field.
# Per call profile: chat, watches (LLM_WATCH_*, defaults to the chat value)
# and titles/summaries (LLM_TITLE_*). Titles never inherit the chat value: they
# default to `low` once LLM_REASONING_EFFORT is set and a title model is
# configured, and send nothing otherwise. Set LLM_TITLE_REASONING_EFFORT=omit
# if your title model rejects the field.
# LLM_REASONING_EFFORT=
# LLM_WATCH_REASONING_EFFORT=
# LLM_TITLE_REASONING_EFFORT=

# Optional: Temperature (0-2) or `omit` to send none. Some models reject the
# field (e.g. Claude Sonnet 5.5). Unset keeps Kyomi's built-in values
# (0.7 chat and watches, 0.1 copilot, 0.3 titles).
# LLM_TEMPERATURE=
# LLM_WATCH_TEMPERATURE=
# LLM_TITLE_TEMPERATURE=

# Optional: Run watches on their own LLM (all fall back to the main LLM when
# unset; reasoning effort and temperature are the LLM_WATCH_REASONING_EFFORT /
# LLM_WATCH_TEMPERATURE values above). A watch provider needs its own key.
# A workspace admin can override these under Settings -> AI.
# LLM_WATCH_PROVIDER=anthropic
# LLM_WATCH_API_KEY=
# LLM_WATCH_BASE_URL=
# LLM_WATCH_MODEL=
# Mode: realtime (default) or batch. Batch uses the provider's batch API at
# about half price; each run takes minutes to hours. Supported for Anthropic
# and OpenRouter (base URL on openrouter.ai) only; anything else is rejected at
# startup. "Run now" is always realtime.
# LLM_WATCH_MODE=realtime
# A watch whose next run is sooner than this runs that occurrence realtime, and
# a batch not finished before the next run is cancelled and re-run realtime.
# LLM_WATCH_BATCH_WINDOW_MINUTES=60
# If a batch fails or expires: realtime_retry (default) retries once in
# realtime, then fails the run; error fails the run immediately.
# LLM_WATCH_BATCH_ON_FAILURE=realtime_retry

# Optional: Web search and web fetch for the chat agent. There is no default
# backend: unless a provider is configured, the tools are not offered to the
# model. Backends: tavily, linkup, builtin (fetch only: Kyomi's own fetcher),
# anthropic (needs LLM_PROVIDER=anthropic), openrouter (needs an openrouter.ai
# LLM_BASE_URL), none. Search queries and fetched URLs are sent to the chosen
# third party. See docs/product/web-access.md.
# WEB_SEARCH_PROVIDER=
# WEB_SEARCH_API_KEY=          # tavily / linkup only
# WEB_SEARCH_BASE_URL=
# WEB_SEARCH_OPTIONS={}        # JSON object passed to the backend unchanged
# WEB_FETCH_PROVIDER=
# WEB_FETCH_API_KEY=
# WEB_FETCH_BASE_URL=
# WEB_FETCH_OPTIONS={}
# Optional domain policy for the `builtin` fetcher (comma-separated; each entry matches
# the domain and its subdomains; the block list wins over the allow list). With an allow
# list set, only those domains can be fetched.
# WEB_FETCH_ALLOWED_DOMAINS=
# WEB_FETCH_BLOCKED_DOMAINS=
# Limits (defaults shown). Per-turn caps and monthly caps (workspace / whole instance).
# WEB_TOOLS_SEARCHES_PER_TURN=5
# WEB_TOOLS_FETCHES_PER_TURN=5
# WEB_TOOLS_WORKSPACE_MONTHLY_CAP=200
# WEB_TOOLS_GLOBAL_MONTHLY_CAP=1000
# Let watches / scheduled runs use the web tools (chat only by default).
# WEB_TOOLS_UNATTENDED=false

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# The external URL where users will access Kyomi.
# Change this if using a domain name or reverse proxy.
KYOMI_URL=http://localhost:8080

# The host port to expose Kyomi on (default: 8080)
# KYOMI_PORT=8080

# WebAuthn Relying Party ID — must match the hostname users access.
# For local installs this should be "localhost".
# For a domain like "kyomi.example.com", set it to "kyomi.example.com".
WEBAUTHN_RP_ID=localhost

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# PASSWORD_AUTH_ENABLED=true
# PASSKEYS_ENABLED=true

# -----------------------------------------------------------------------------
# Optional — Email (SMTP)
# -----------------------------------------------------------------------------
# Uncomment to enable email notifications (watch alerts, invitations, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=kyomi@example.com
# SMTP_FROM_NAME=Kyomi

# -----------------------------------------------------------------------------
# Optional — Web Push Notifications
# -----------------------------------------------------------------------------
# Generate VAPID keys with: npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT=mailto:admin@example.com
#
# Push subscription endpoints are only accepted from a built-in allowlist of
# browser push services (FCM, Mozilla autopush, WNS, APNs). If you run your
# own push relay instead of a browser's default push service, name its
# host(s) here (comma-separated) to allow it too. Leave unset otherwise.
# IMPORTANT: if you use a custom relay, set this BEFORE upgrading. On
# upgrade, a one-time SQL migration purges existing push_subscriptions rows
# that don't match an allowed host, and that migration cannot see this env
# var — it will delete your custom-relay rows if this isn't set yet. A
# startup sweep runs right after on every boot and DOES see this env var, so
# once it's set, your custom-relay subscriptions are correctly kept going
# forward — it just can't restore rows the migration already deleted.
# PUSH_ALLOWED_ENDPOINT_HOSTS=

# -----------------------------------------------------------------------------
# Optional — Google OAuth (for Google sign-in and BigQuery datasources)
# -----------------------------------------------------------------------------
# Create credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Optional — Slack Integration (Enterprise only)
# -----------------------------------------------------------------------------
# Create a Slack app at https://api.slack.com/apps
# Required scopes: chat:write, commands, app_mentions:read
# Set the OAuth redirect URL to: ${KYOMI_URL}/api/v1/slack/oauth/callback
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
